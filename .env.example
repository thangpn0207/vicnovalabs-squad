# ==============================================================================
# VicnovaLabs Squad Configuration
# ==============================================================================
# Copy this file to .env and configure your personal parameters.
# NEVER commit your actual .env file with secrets to version control.

# Optional: Path to custom squad directory (defaults to repo root or ~/.squad)
# SQUAD_HOME=/path/to/custom/squad

# Optional: Custom path to skills directory
# SQUAD_SKILLS_PATH=/path/to/skills

# Optional: TypeSafe AI or LLM API Key for probabilistic triage & fidelity scoring
# (System automatically falls back to offline zero-token heuristics if omitted)
# TYPESAFE_API_KEY=your_typesafe_api_key_here

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
SQUAD_LOG_LEVEL=INFO

# Optional: Target platform preference (web or mobile)
SQUAD_DEFAULT_PLATFORM=web

# Optional: Squad dispatch mode (suggest, smart, auto, inline)
# - suggest : (DEFAULT) Suggest squad subagents with a skill-like card; execute directly inline unless explicitly summoned
# - smart   : Auto-dispatch for complexity >= 4 or composite fanout; suggest for routine tasks
# - auto    : Legacy autonomous mode; always auto-dispatch subagents
# - inline  : Always execute inline directly without suggestions
SQUAD_DISPATCH_MODE=suggest

